{
  "name": "geulttukttak-kinder",
  "productName": "유치원 글뚝딱",
  "version": "1.0.1",
  "private": true,
  "description": "유치원 글뚝딱 — 유치원 블로그 작가 (설치형)",
  "main": "out/main/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "lint": "tsc --noEmit",
    "dist": "node scripts/build.mjs && electron-builder --win nsis",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac dir --arm64 --x64"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "openai": "^7.36.0",
    "zod": "^4.6.7",
    "fflate": "^0.8.3",
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@fontsource/black-han-sans": "^5.3.0"
  },
  "dependencies": {
    "playwright-core": "^1.64.1"
  },
  "author": "용감한개발자",
  "build": {
    "appId": "kr.ddalkak.geulttukttak-kinder",
    "productName": "유치원 글뚝딱",
    "copyright": "© 2026 그로우모먼트",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "!out/**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/fonts",
        "to": "fonts"
      },
      {
        "from": "LICENSES.md",
        "to": "LICENSES.md"
      }
    ],
    "asarUnpack": [
      "node_modules/playwright-core/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Kinder-Geulttukttak-Setup-${version}.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "shortcutName": "유치원 글뚝딱",
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "language": "1042"
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "Kinder-Geulttukttak-Mac-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "유치원 메모를 말로 넣을 때 마이크를 써요. 녹음은 글자로 바꾼 뒤 저장하지 않아요."
      }
    }
  }
}
